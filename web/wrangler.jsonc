{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magics-viewer",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "magics.zapalsky.com", "custom_domain": true }
  ],
  "previews": {},
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
