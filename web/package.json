{
  "name": "magics-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "refresh:cards": "node scripts/refresh-cards.ts",
    "validate": "node scripts/validate.ts",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "build": "pnpm validate && astro build && node scripts/check-static.ts && node scripts/check-bundle.ts",
    "preview": "astro preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787 --show-interactive-dev-session=false",
    "test:cloudflare": "node scripts/check-cloudflare.ts",
    "ci:build": "pnpm check && pnpm test && pnpm build && ../scripts/validate-deck.sh ../decks/lathril/decklist.txt",
    "deploy:check": "pnpm ci:build && wrangler deploy --dry-run --outdir test-results/deploy",
    "deploy": "pnpm ci:build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.3.6",
    "@astrojs/svelte": "9.0.1",
    "svelte": "^5.54.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@astrojs/check": "^0.9.4",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "workerd"] }
}
