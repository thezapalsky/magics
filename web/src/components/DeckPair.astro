---
import DeckCover from './DeckCover.astro';
import { lathrilRelation } from '../lib/deck-relation.ts';
import type { CardMetadata, LoadedDeck } from '../lib/types.ts';
interface Props {
  paper: LoadedDeck & { cover: CardMetadata };
  arena: LoadedDeck & { cover: CardMetadata };
}
const { paper, arena } = Astro.props;
const relation = lathrilRelation(paper, arena);
---
<div class="deck-pair" data-deck-pair role="group" aria-label="Paper Lathril and its Arena practice target">
  <div class="paired-covers">
    <DeckCover deck={paper} compact eager />
    <DeckCover deck={arena} compact eager />
  </div>
  <details class="deck-relation">
    <summary aria-label="Why these Lathril decks are similar; show card differences">
      <span>{relation.sharedCount} shared cards</span><span class="relation-count">{relation.substitutions.length} swaps <span aria-hidden="true">ⓘ</span></span>
    </summary>
    <div class="relation-panel">
      <p>Same deck, two places to play. The Arena target is for practising the paper list, with three substitutions.</p>
      <div class="diff-heading"><span>Paper</span><span aria-hidden="true"></span><span>Arena</span></div>
      <ul aria-label="Paper to Arena substitutions">
        {relation.substitutions.map(swap => <li><span>{swap.paper}</span><span class="swap-arrow" aria-label="replaced by">→</span><span>{swap.arena}</span></li>)}
      </ul>
      <p class="relation-footnote">Commander / Brawl · not identical game conditions.</p>
    </div>
  </details>
</div>

<script>
  for (const pair of document.querySelectorAll<HTMLElement>('[data-deck-pair]')) {
    const disclosure = pair.querySelector<HTMLDetailsElement>('details')!;
    // Native details provides tap/keyboard access even without JavaScript.
    pair.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse' && matchMedia('(hover: hover)').matches) disclosure.open = true;
    });
    pair.addEventListener('pointerleave', () => {
      if (!pair.contains(document.activeElement)) disclosure.open = false;
    });
    pair.addEventListener('focusin', event => {
      if ((event.target as HTMLElement).closest('.deck-cover')) disclosure.open = true;
    });
    pair.addEventListener('focusout', event => {
      if (!pair.contains(event.relatedTarget as Node | null)) disclosure.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && disclosure.open) {
        event.preventDefault();
        disclosure.open = false;
      }
    });
    document.addEventListener('pointerdown', event => {
      if (!pair.contains(event.target as Node)) disclosure.open = false;
    });
  }
</script>

<style>
  .deck-pair { position: relative; min-width: 0; }
  .paired-covers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; height: 100%; }
  .deck-relation { position: absolute; z-index: 2; top: .7rem; left: .7rem; right: .7rem; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 36px; padding: .55rem .65rem; border: 1px solid #68775c66; border-radius: 6px; background: #172016e8; color: #cbd7c0; font-size: .65rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .relation-count { color: var(--accent); white-space: nowrap; }
  .relation-count span { margin-left: .3rem; }
  .relation-panel { position: absolute; top: calc(100% + .35rem); left: 0; right: 0; padding: .9rem; background: #1d251bfa; border: 1px solid #68775c88; border-radius: 8px; box-shadow: 0 12px 28px #0005; font-size: .72rem; line-height: 1.5; }
  .relation-panel p { margin: 0 0 .9rem; color: #cbd0c1; }
  .diff-heading, li { display: grid; grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1fr); gap: .4rem; align-items: center; }
  .diff-heading { color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font-size: .55rem; margin-bottom: .35rem; }
  ul { padding: 0; margin: 0; list-style: none; }
  li { padding-block: .35rem; border-top: 1px solid var(--line); }
  .swap-arrow { color: var(--accent); }
  .relation-panel .relation-footnote { margin: .8rem 0 0; color: var(--muted); font-size: .6rem; }
  @media (max-width: 600px) { summary { min-height: 44px; } .deck-relation { top: .5rem; left: .5rem; right: .5rem; } .relation-panel { padding: .75rem; font-size: .7rem; } }
</style>
