---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Magics - my decks & binder', description = 'Paper Commander and Arena Brawl decklists, saved versions, and the Spider-Man character binder.' } = Astro.props;
const binderPage = Astro.url.pathname.startsWith('/collections/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191c18" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Magics home"><span class="brand-mark" aria-hidden="true">✳</span> magics<span class="wordmark-dot">.</span></a>
      <span class="header-note">a deck & collection notebook</span>
      <nav class="site-nav" aria-label="Main navigation"><a href="/" aria-current={!binderPage ? 'page' : undefined}>Decks</a><a href="/collections/spider-man/" aria-current={binderPage ? 'page' : undefined}>Binder</a></nav>
      <a href="https://github.com/thezapalsky/magics" target="_blank" rel="noopener noreferrer" class="repo-link"><span class="repo-full">The repository</span><span class="repo-short">GitHub</span> <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <span>Paper Commander, Arena Brawl & the Spider-Man binder.</span>
      <span>Card data & artwork via <a href="https://scryfall.com" target="_blank" rel="noopener noreferrer">Scryfall</a>.<br />Magic: The Gathering © Wizards of the Coast. Unofficial fan project.</span>
    </footer>
  </body>
</html>
